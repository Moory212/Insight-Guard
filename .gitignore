# Virtual environment
venv/
env/
.venv/

# Python cache
__pycache__/
*.pyc
*.pyo

# Streamlit
.streamlit/

# Exclude large model binaries (BERT weights, etc.)
models/**/*.bin
models/**/*.pt
models/**/*.safetensors
models/**/*.onnx
models/**/*.h5
models/**/*.keras
models/**/*.joblib

# But include small pipeline, vectorizer, and metadata files
!models/*_pipeline.pkl
!models/*_model.pkl
!models/*_vectorizer.pkl
!models/*_metadata.pkl
!models/*.json
!models/*.txt

# Data files – exclude most raw files, keep compressed dataset
data/raw/*.csv
data/raw/*.tsv
data/raw/*.zip
data/raw/*.tar
data/raw/*.pkl
data/raw/*.pt
data/raw/liar/
data/raw/pheme.zip

# But keep the compressed unified dataset and the two small CSVs
!data/raw/unified_dataset.csv.gz
!data/raw/balanced_dataset.csv
!data/raw/augmented_fake.csv